                      <IfController guiclass="IfControllerPanel" testclass="IfController" testname="put_6 IF" enabled="true">
                        <stringProp name="IfController.condition">${__jexl3(&quot;${put}&quot; == &quot;put_2&quot;)}</stringProp>
