            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

// Obtener la respuesta JSON como String
def response = prev.getResponseDataAsString()

// Parsear JSON
def json = new JsonSlurper().parseText(response)

// Obtener la lista de objetos
def list = json?.result?.list

if (list == null) {
    log.warn(&quot;No se encontró &apos;result.list&apos; en la respuesta JSON&quot;)
    return
}

// Recorrer la lista y extraer evaluationStatus.id o asignar mensaje si no existe
list.eachWithIndex { item, index -&gt;
    def evalStatusId = &quot;evaluationStatusId_${index + 1}&quot;
    def idValue = item?.evaluationStatus?.id
    if (idValue != null) {
        vars.put(evalStatusId, idValue.toString())
    } else {
        vars.put(evalStatusId, &quot;${evalStatusId} not found&quot;)
    }
    log.info(&quot;${evalStatusId} = ${vars.get(evalStatusId)}&quot;)
}

// Guardar la cantidad total para usar en loops si es necesario
vars.put(&quot;evaluationStatusId_matchNr&quot;, list.size().toString())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
